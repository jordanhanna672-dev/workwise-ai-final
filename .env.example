# Copy this file to ".env" if you want to try the real-AI mode.
# The app runs perfectly well with NO .env file at all (heuristic mode).

# Optional. If set, the Smart Task Extractor calls OpenAI's API instead
# of using the built-in keyword/pattern rules.
OPENAI_API_KEY=

# Optional. Defaults to 3000.
PORT=3000

# Optional. If set (64 hex chars = 32 bytes), the task data store is
# encrypted at rest with AES-256-GCM instead of plain JSON. Generate one
# with: node scripts/generate-encryption-key.js
DATA_ENCRYPTION_KEY=

# Optional. Enables the Gmail/Calendar read-only sync feature. See
# docs/google-integration.md for how to obtain these from Google Cloud
# Console. Leave blank to skip this feature entirely - the app works
# fine without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if you're not using the default http://localhost:<PORT>/oauth2callback
GOOGLE_REDIRECT_URI=

# Optional. If set, the app uses PostgreSQL instead of the local JSON
# file (data/tasks.json) - this is what Render's one-click deploy sets
# automatically. Requires `npm install pg --no-save` first. See
# docs/adr/0005-postgres-on-render.md for how to test this locally with
# Docker before trusting it with real data.
DATABASE_URL=
